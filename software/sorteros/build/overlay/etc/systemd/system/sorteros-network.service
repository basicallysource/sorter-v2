[Unit]
Description=SorterOS network bring-up: Ethernet, else saved Wi-Fi, else the setup network
Documentation=https://docs.basically.website/sorter/installation/sorter-os/
After=NetworkManager.service
Wants=NetworkManager.service
Before=sorteros-firstboot.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/sbin/sorteros-network.py
# Exits 0 once the machine is online. A crash (say the Wi-Fi driver refuses
# access-point mode) retries after a pause instead of giving up for the boot.
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=0
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
