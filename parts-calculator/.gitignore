# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Slicer scratch (3mf, cache, resolved profiles) — regenerated locally
catalog/build/
__pycache__/

# Note: src/lib/data/*.generated.json are generated by catalog/generate.py and
# ARE committed — they're the site's input. NOTHING binary is committed: STL
# masters, plates, renders, thumbnails, and the all-parts zip all live in the
# content-addressed asset service, pinned by hash/URL (scripts/publish_assets.py).

# stray OrcaSlicer logs
catalog/*.log

# raw STL drop zone (publish with scripts/publish_assets.py --upload, pin the hash)
catalog/inbox/

# Product images never enter git. Publish them and reference the URL:
#   python scripts/publish_assets.py --upload <file>   -> paste the image_url
# This used to be an LFS directory; pointer stubs got published as the images
# and broke every hardware photo on the site. See CLAUDE.md.
catalog/images/

# Version snapshots are derived from git history at build time
# (scripts/version-snapshots.mjs) — never committed.
static/versions/
